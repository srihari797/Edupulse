# ============================================================
# EduPulse Full-Stack Production Environment Variables
# ============================================================

# ------------------------------------------------------------
# 1. Frontend Configuration (Public URLs)
# Point to your production domain or server IP
# ------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_VISION_API_BASE_URL=https://vision.yourdomain.com

# ------------------------------------------------------------
# 2. Backend API Configuration
# ------------------------------------------------------------
APP_NAME=EduPulse
APP_ENV=production
DEBUG=false
SECRET_KEY=change_this_to_a_long_random_secure_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ADSA Data Source Mode (real = Supabase PostgreSQL, mock = In-Memory)
DATA_SOURCE=real
USE_MOCK=false

# Supabase PostgreSQL (Strict 'edupulse' schema)
DATABASE_URL=postgresql://postgres:your_db_password@db.your_supabase_ref.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://your_supabase_ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# AI Engine (Groq Cloud API)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------
# 3. Vision & Vector DB Service
# ------------------------------------------------------------
VECTOR_STORE_PATH=/app/vision/vector_store/face_vectors.json
ATTENDANCE_DB_PATH=/app/vision/vector_store/attendance.db
